{
  "version": 1,
  "package": "fabric-plan-skill",
  "classification": {
    "runtime-required": [
      "SKILL.md",
      "README.md",
      "LICENSE",
      "apm.yml",
      "references/",
      "scripts/plan.py",
      "scripts/runtime/",
      "scripts/tools/",
      "scripts/vendor/",
      "assets/catalog/",
      "assets/fixtures/",
      "assets/schemas/",
      "assets/examples/five-usecases/",
      "assets/preservation-manifest.json"
    ],
    "manual-examples": [
      "assets/examples/"
    ],
    "offline-tests": [
      "tests/"
    ],
    "excluded-from-package": [
      "_brief/",
      "_build/",
      "_samples/",
      ".changeset/",
      ".github/",
      ".trail/",
      "build/",
      "**/__pycache__/",
      "**/*.pyc",
      "**/*.pyo"
    ]
  },
  "retained-unreferenced-assets": {
    "assets/examples/business-intent/quarterly-targets.recipe.json": "manual-example",
    "assets/examples/five-usecases/business-prompts.txt": "manual-example",
    "assets/examples/five-usecases/destination.example.json": "manual-example",
    "assets/examples/forecast-repair.request.json": "manual-example",
    "assets/examples/forecast-review.request.json": "manual-example",
    "assets/examples/header-fit.request.json": "manual-example",
    "assets/examples/hierarchy-icons.request.json": "manual-example",
    "assets/examples/measure-display.request.json": "manual-example",
    "assets/examples/planning-integrity.properties.json": "manual-example",
    "assets/examples/planning-presentation.request.json": "manual-example",
    "assets/fixtures/navigator-spec-*.json": "offline-test",
    "assets/fixtures/negative-variance-rule.json": "offline-test",
    "scripts/tools/audit_report_definitions.py": "maintenance-tool"
  },
  "limits": {
    "references_markdown_max_bytes": 20000,
    "tracked_bytecode_allowed": false
  },
  "notes": {
    "assets/examples/five-usecases/": "Runtime-required: scripts/runtime/usecases.py reads it. The rest of assets/examples/ is manual."
  }
}
