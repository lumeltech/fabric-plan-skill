__pycache__/
*.py[cod]
# Local coverage runs from .coveragerc; the CI step regenerates them.
.coverage
.coverage.*
/coverage.json
# Local validation findings against private product code; never commit.
/findings/
# Local eval runs: per-developer settings and results stay on each machine.
/tests/evals/local.config.json
/vally-results/
.gitignore
